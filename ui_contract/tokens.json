{
  "version": "2026-03-29",
  "style_anchor": "mi-hybrid",
  "product_principles": [
    "content-first",
    "security-visible-not-dominant",
    "icon-led-low-text",
    "high-density-low-noise",
    "platform-native-adaptation"
  ],
  "theme_policy": {
    "supports": [
      "light",
      "dark"
    ],
    "default_mode": "system",
    "windows_fallback_mode": "light",
    "respect_reduced_motion": true
  },
  "spacing": {
    "base": 4,
    "scale": [
      4,
      8,
      12,
      16,
      20,
      24,
      32
    ]
  },
  "radius": {
    "small": 8,
    "medium": 12,
    "large": 16,
    "xlarge": 20,
    "pill": 24
  },
  "typography": {
    "primary_cjk": "Source Han Sans SC",
    "primary_latin": "Source Sans 3",
    "monospace": "JetBrains Mono",
    "roles": {
      "display": {
        "size": 24,
        "line_height": 28,
        "weight": 600
      },
      "title": {
        "size": 20,
        "line_height": 24,
        "weight": 600
      },
      "subtitle": {
        "size": 16,
        "line_height": 22,
        "weight": 500
      },
      "body": {
        "size": 15,
        "line_height": 22,
        "weight": 400
      },
      "caption": {
        "size": 12,
        "line_height": 16,
        "weight": 500
      },
      "overline": {
        "size": 11,
        "line_height": 14,
        "weight": 500
      }
    }
  },
  "semantic_colors": {
    "light": {
      "background": "#F5F7FA",
      "surface": "#FFFFFF",
      "surface_raised": "#FFFFFF",
      "surface_variant": "#F0F2F5",
      "text_primary": "#1C1C1E",
      "text_secondary": "#6B7280",
      "text_muted": "#8D97A5",
      "accent": "#2AABEE",
      "accent_strong": "#1E84BA",
      "success": "#28C76F",
      "warning": "#FF9F1C",
      "danger": "#FF4D4F",
      "divider": "#E5E7EB",
      "bubble_incoming": "#FFFFFF",
      "bubble_outgoing": "#DDF5EC",
      "focus": "#2AABEE",
      "hover": "#E9F3FB",
      "pressed": "#DCE9F5",
      "disabled": "#B7C3CF"
    },
    "dark": {
      "background": "#091117",
      "surface": "#101922",
      "surface_raised": "#141F29",
      "surface_variant": "#182431",
      "text_primary": "#E8EDF4",
      "text_secondary": "#9DAEBC",
      "text_muted": "#7F92A2",
      "accent": "#4E7FFF",
      "accent_strong": "#6A94FF",
      "success": "#35B38A",
      "warning": "#D9A25A",
      "danger": "#F07C7C",
      "divider": "#2B3846",
      "bubble_incoming": "#16212B",
      "bubble_outgoing": "#214B40",
      "focus": "#4E7FFF",
      "hover": "#1A2834",
      "pressed": "#223446",
      "disabled": "#516171"
    }
  },
  "iconography": {
    "primary_source": "mi-owned-svg",
    "stroke_width": 1.5,
    "sizes": [
      20,
      24
    ],
    "fallbacks": {
      "ios": "sf-symbols",
      "android": "mi-owned-icons-wrapper",
      "windows": "qrc-svg"
    }
  },
  "motion": {
    "fast_ms": 160,
    "standard_ms": 220,
    "max_primary_ms": 300
  },
  "layout": {
    "app_bar_height": 56,
    "desktop_top_bar_height": 56,
    "conversation_row_height": 64,
    "avatar_size": 44,
    "input_height_min": 48,
    "input_height_max": 52,
    "primary_button_height": 48,
    "secondary_button_height": 40,
    "message_bubble_max_width_ratio": 0.76,
    "message_bubble_min_height": 36,
    "message_bubble_radius": 18,
    "security_status_mode": "inline-primary-flow"
  },
  "desktop_breakpoints": {
    "three_column_min_width": 1360,
    "two_column_drawer_min_width": 1120,
    "compact_two_column_min_width": 980
  }
}
